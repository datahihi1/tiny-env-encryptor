#!/usr/bin/env php
<?php

declare(strict_types=1);

use Datahihi1\TinyEnv\Decryptor;
use Datahihi1\TinyEnv\EncryptedValue;
use Datahihi1\TinyEnv\Encryptor;
use Datahihi1\TinyEnv\EnvFileEnc;
use Datahihi1\TinyEnv\SecretKey;
use Datahihi1\TinyEnv\TinyEnv;

(function (): void {
    // Works both from a git checkout and from vendor/datahihi1/tiny-env-encryptor.
    $candidates = [
        __DIR__ . '/vendor/autoload.php',
        __DIR__ . '/../../autoload.php',
        __DIR__ . '/../../../vendor/autoload.php',
        __DIR__ . '/../../../../vendor/autoload.php',
    ];

    foreach ($candidates as $autoload) {
        if (is_file($autoload)) {
            require $autoload;

            return;
        }
    }

    fwrite(STDERR, "Composer autoloader not found. Run `composer install` first." . PHP_EOL);
    exit(1);
})();

/**
 * Print a message to STDERR and exit with a failure status.
 *
 * @param string $message
 * @return void
 */
function fail(string $message): void
{
    fwrite(STDERR, $message . PHP_EOL);
    exit(1);
}

/**
 * Print a non-fatal warning to STDERR.
 *
 * @param string $message
 * @return void
 */
function warn(string $message): void
{
    fwrite(STDERR, 'Warning: ' . $message . PHP_EOL);
}

/**
 * Build the help text.
 *
 * @param string $script
 * @return string
 */
function usage(string $script): string
{
    return <<<TXT
TinyEnv Encryptor v1.1.0 - A simple tool to encrypt .env values

Usage:
  {$script} generate                                                  Generate a new encryption key
  {$script} encrypt <key> <input.env> [output.env] [key1 key2 ...]    Encrypt .env values
  {$script} decrypt <key> <input.env> [output.env] [key1 key2 ...]    Decrypt .env values

Arguments:
  <key>          Base64-encoded 32-byte key, as printed by `generate`.
                 Use `-` to read it from the TINY_ENV_KEY environment
                 variable, or from STDIN if that is not set, so the key
                 never appears in your shell history or process list.
  [output.env]   Defaults to the input file for `encrypt`, and to
                 <input.env>.decrypted for `decrypt`.
  [key1 ...]     Variables to act on. Defaults to every variable in the file.

Comments, blank lines and the order of the file are preserved; values that
are already encrypted are never encrypted a second time.

Examples:
  {$script} encrypt abc123def456 .env .env.encrypted
  {$script} encrypt abc123def456 .env .env.encrypted DB_PASSWORD API_SECRET
  {$script} decrypt abc123def456 .env.encrypted .env.decrypted
  {$script} decrypt - .env.encrypted .env.decrypted DB_PASSWORD

TXT;
}

/**
 * Resolve and validate the secret key argument.
 *
 * @param string $argument The key as given on the command line, or `-`
 * @return string The base64-encoded key
 */
function resolveSecretKey(string $argument): string
{
    $key = $argument;

    if ($key === '-') {
        $fromEnv = getenv('TINY_ENV_KEY');

        if ($fromEnv !== false && trim($fromEnv) !== '') {
            $key = $fromEnv;
        } else {
            $line = fgets(STDIN);
            $key = $line === false ? '' : $line;
        }
    }

    $key = trim($key);

    if (!SecretKey::isValid($key)) {
        fail(sprintf(
            'Invalid key: expected a base64-encoded %d-byte key (run `generate` to create one).',
            SecretKey::LENGTH
        ));
    }

    return $key;
}

/**
 * Read and parse a `.env` file.
 *
 * @param string $path
 * @return array{0: array<int, array<string, mixed>>, 1: string} Entries and the file's line ending
 */
function readEnvFile(string $path): array
{
    if (!is_file($path)) {
        fail("File not found: $path");
    }

    $contents = file_get_contents($path);

    if ($contents === false) {
        fail("Unable to read: $path");
    }

    return [EnvFileEnc::parse($contents), EnvFileEnc::detectEol($contents)];
}

/**
 * Write entries back out as a `.env` file.
 *
 * @param string                           $path
 * @param array<int, array<string, mixed>> $entries
 * @param string                           $eol Line ending to write
 * @return void
 */
function writeEnvFile(string $path, array $entries, string $eol): void
{
    $directory = dirname($path);

    if (!is_dir($directory)) {
        fail("Directory not found: $directory");
    }

    $isNew = !file_exists($path);

    if (file_put_contents($path, EnvFileEnc::format($entries, $eol)) === false) {
        fail("Error writing to: $path");
    }

    // A freshly created env file holds secrets; keep it owner-only. An
    // existing file keeps whatever permissions the user chose for it.
    if ($isNew) {
        @chmod($path, 0600);
    }
}

/**
 * Resolve `${VAR}` references in a value.
 *
 * References are resolved against the file's own variables first, then the
 * loaded environment. TinyEnv is only loaded if a reference is actually found.
 *
 * @param string                $value
 * @param array<string, string> $fileValues
 * @param string                $inputFile
 * @return string
 */
function interpolate(string $value, array $fileValues, string $inputFile): string
{
    if (strpos($value, '${') === false) {
        return $value;
    }

    $resolved = preg_replace_callback(
        '/\$\{([A-Za-z_][A-Za-z0-9_]*)\}/',
        function (array $match) use ($fileValues, $inputFile): string {
            $name = $match[1];

            // Prefer the file's own value, unless it is itself a reference.
            if (isset($fileValues[$name]) && strpos($fileValues[$name], '${') === false) {
                return $fileValues[$name];
            }

            return environmentValue($name, $inputFile);
        },
        $value
    );

    return $resolved === null ? $value : $resolved;
}

/**
 * Look up a variable in the environment, loading TinyEnv on first use.
 *
 * @param string $name
 * @param string $inputFile
 * @return string
 */
function environmentValue(string $name, string $inputFile): string
{
    static $loaded = false;

    if (!$loaded) {
        $loaded = true;

        try {
            $directory = dirname($inputFile);
            (new TinyEnv($directory === '' ? '.' : $directory))->load();
        } catch (\Throwable $e) {
            // No .env to load here; fall back to the process environment.
        }
    }

    $value = TinyEnv::env($name, null);

    if ($value === null) {
        $value = getenv($name);

        if ($value === false) {
            return '';
        }
    }

    return is_scalar($value) ? (string) $value : '';
}

/**
 * Report which keys the command acted on.
 *
 * @param string             $action
 * @param string             $inputFile
 * @param string             $outputFile
 * @param array<int, string> $affected
 * @param bool               $all
 * @return void
 */
function report(string $action, string $inputFile, string $outputFile, array $affected, bool $all): void
{
    echo "{$action} successfully!" . PHP_EOL;
    echo "Input : {$inputFile}" . PHP_EOL;
    echo "Output: {$outputFile}" . PHP_EOL;
    echo "{$action} keys: " . ($affected === [] ? 'none' : ($all ? 'ALL (' . implode(', ', $affected) . ')' : implode(', ', $affected))) . PHP_EOL;
}

/**
 * Warn about requested keys that the file does not contain.
 *
 * @param array<int, string>    $requested
 * @param array<string, string> $available
 * @return void
 */
function warnUnknownKeys(array $requested, array $available): void
{
    $unknown = array_diff(array_unique($requested), array_keys($available));

    if ($unknown !== []) {
        warn('key(s) not found in the input file: ' . implode(', ', $unknown));
    }
}

/**
 * `generate` command: print a new encryption key.
 *
 * @return void
 */
function generateCommand(): void
{
    $key = Encryptor::generateKey();

    echo "Your encryption key (keep it safe!):" . PHP_EOL . PHP_EOL;
    echo $key . PHP_EOL . PHP_EOL;
}

/**
 * `encrypt` command.
 *
 * @param array<int, string> $args
 * @return void
 */
function encryptCommand(array $args): void
{
    if (count($args) < 2) {
        fail('Usage: tiny-env-encrypt encrypt <base64-key|-> <input.env> [output.env] [key1 key2 ...]');
    }

    $secretKey = resolveSecretKey($args[0]);
    $inputFile = $args[1];
    $outputFile = $args[2] ?? $inputFile;
    $requested = array_slice($args, 3);

    list($entries, $eol) = readEnvFile($inputFile);
    $variables = EnvFileEnc::toArray($entries);

    if ($requested !== []) {
        warnUnknownKeys($requested, $variables);
    }

    // Hash lookup keeps the pass over the file linear.
    $selected = $requested === [] ? null : array_fill_keys($requested, true);

    $encryptor = new Encryptor($secretKey);
    $encrypted = [];
    $alreadyEncrypted = [];

    foreach ($entries as $index => $entry) {
        if ($entry['type'] !== EnvFileEnc::TYPE_PAIR) {
            continue;
        }

        $key = $entry['key'];

        if ($selected !== null && !isset($selected[$key])) {
            continue;
        }

        if (EncryptedValue::looksLikeEnvelope($entry['value'])) {
            $alreadyEncrypted[] = $key;
            continue;
        }

        $plain = interpolate($entry['value'], $variables, $inputFile);

        try {
            $entries[$index]['value'] = $encryptor->encryptValue($plain);
        } catch (\RuntimeException $e) {
            fail("{$key}: " . $e->getMessage());
        }

        $encrypted[] = $key;
    }

    writeEnvFile($outputFile, $entries, $eol);

    if ($alreadyEncrypted !== []) {
        warn('already encrypted, left unchanged: ' . implode(', ', $alreadyEncrypted));
    }

    report('Encrypted', $inputFile, $outputFile, $encrypted, $selected === null);
}

/**
 * `decrypt` command.
 *
 * @param array<int, string> $args
 * @return void
 */
function decryptCommand(array $args): void
{
    if (count($args) < 2) {
        fail('Usage: tiny-env-encrypt decrypt <base64-key|-> <input.env.encrypted> [output.env] [key1 key2 ...]');
    }

    $secretKey = resolveSecretKey($args[0]);
    $inputFile = $args[1];
    $outputFile = $args[2] ?? $inputFile . '.decrypted';
    $requested = array_slice($args, 3);

    list($entries, $eol) = readEnvFile($inputFile);
    $variables = EnvFileEnc::toArray($entries);

    if ($requested !== []) {
        warnUnknownKeys($requested, $variables);
    }

    $selected = $requested === [] ? null : array_fill_keys($requested, true);

    $decryptor = new Decryptor($secretKey);
    $decrypted = [];

    foreach ($entries as $index => $entry) {
        if ($entry['type'] !== EnvFileEnc::TYPE_PAIR) {
            continue;
        }

        $key = $entry['key'];

        if ($selected !== null && !isset($selected[$key])) {
            continue;
        }

        if (!EncryptedValue::looksLikeEnvelope($entry['value'])) {
            continue;
        }

        try {
            // Fail loudly: a wrong key must never overwrite a secret with "".
            $entries[$index]['value'] = $decryptor->decrypt($entry['value'], true);
        } catch (\RuntimeException $e) {
            fail("{$key}: " . $e->getMessage() . ' Nothing was written.');
        }

        $decrypted[] = $key;
    }

    writeEnvFile($outputFile, $entries, $eol);

    report('Decrypted', $inputFile, $outputFile, $decrypted, $selected === null);
}

$args = $_SERVER['argv'];
$script = basename((string) array_shift($args));

if ($args === []) {
    fwrite(STDERR, usage($script));
    exit(1);
}

$command = array_shift($args);

try {
    switch ($command) {
        case 'generate':
            generateCommand();
            break;

        case 'encrypt':
            encryptCommand($args);
            break;

        case 'decrypt':
            decryptCommand($args);
            break;

        case 'help':
        case '--help':
        case '-h':
            echo usage($script);
            break;

        default:
            fail("Unknown command: {$command}" . PHP_EOL . PHP_EOL . usage($script));
    }
} catch (\InvalidArgumentException $e) {
    fail($e->getMessage());
} catch (\Throwable $e) {
    fail(get_class($e) . ': ' . $e->getMessage());
}
